# Placeholders only. Copy to .env (git-ignored). tasks.py reads .env; variables already set in
# the shell win. Never commit real values. Hosted values: docs/deploy-runbook.md section 9.
# Random, 50+ characters. With DJANGO_DEBUG=0 settings refuse this placeholder and any key
# shorter than 50 characters (D89). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# 1 for local development only.
DJANGO_DEBUG=0
# Comma-separated host names. Required when DJANGO_DEBUG=0 (settings refuse to start without).
DJANGO_ALLOWED_HOSTS=
# PostgreSQL connection (D39). Percent-encode special characters in the password.
DATABASE_URL=postgres://verified_stays:change-me@localhost:5432/verified_stays
# Client address for the login throttle (D62). REMOTE_ADDR with no proxy; behind a proxy the
# header it appends to (e.g. HTTP_X_FORWARDED_FOR) and how many trusted proxies append to it.
# Required when DJANGO_DEBUG=0.
DJANGO_CLIENT_IP_HEADER=REMOTE_ADDR
DJANGO_TRUSTED_PROXY_HOPS=1
# Comma-separated origins (scheme + host) allowed for CSRF behind HTTPS, production only.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only (DJANGO_DEBUG=0), optional. HTTPS redirect: 1 (default); 0 only for a local
# plain-HTTP container run. HSTS max-age in seconds (default one year).
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
# DEBUG, INFO (default), WARNING, ERROR. Logs are JSON lines on stdout, scrubbed (D84).
DJANGO_LOG_LEVEL=INFO
