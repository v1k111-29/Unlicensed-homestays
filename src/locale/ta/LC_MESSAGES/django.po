msgstr "வரி %(line)d-இன் மறுபதிப்பு"

#: ingest/uploads.py
#, python-format
msgid "unknown data set '%(name)s'"
msgstr "தெரியாத தரவுத் தொகுப்பு '%(name)s'"

#: ingest/uploads.py
#, python-format
msgid "district '%(name)s' is not your district (%(own)s); you can upload listings for your own district only, so the whole file is rejected"
msgstr "'%(name)s' மாவட்டம் உங்கள் மாவட்டம் (%(own)s) அல்ல; உங்கள் மாவட்டத்துக்கான பட்டியல்களை மட்டுமே பதிவேற்ற முடியும், எனவே முழுக் கோப்பும் நிராகரிக்கப்பட்டது"

#: ingest/views.py
msgid "Uploaded registry"
msgstr "பதிவேற்றப்பட்ட பதிவேடு"

#: ingest/views.py
#, python-format
