#: config/django_strings.py
#, python-format
msgid "Please enter a correct %(username)s and password. Note that both fields may be case-sensitive."
msgstr "சரியான %(username)s மற்றும் கடவுச்சொல்லை உள்ளிடவும். இரண்டிலும் பெரிய, சிறிய எழுத்து வேறுபாடு கணக்கில் கொள்ளப்படலாம்."

#: config/django_strings.py
msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "சரியான தேர்வைத் தேர்ந்தெடுக்கவும். அந்தத் தேர்வு கிடைக்கும் தேர்வுகளில் இல்லை."

#: config/django_strings.py
#, python-format
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "சரியான தேர்வைத் தேர்ந்தெடுக்கவும். %(value)s கிடைக்கும் தேர்வுகளில் இல்லை."

#: ingest/csvtools.py
msgid "file has a header but no data rows"
msgstr "கோப்பில் தலைப்பு வரி உள்ளது, ஆனால் தரவு வரிகள் இல்லை"

#: ingest/csvtools.py
msgid "required value is empty"
msgstr "தேவையான மதிப்பு காலியாக உள்ளது"

#: ingest/csvtools.py
msgid "must be 6 digits or empty"
msgstr "6 இலக்கங்களாக இருக்க வேண்டும் அல்லது காலியாக இருக்க வேண்டும்"

#: ingest/csvtools.py
msgid "lat and lng must both be given or both be empty"
msgstr "lat, lng இரண்டும் கொடுக்கப்பட வேண்டும் அல்லது இரண்டும் காலியாக இருக்க வேண்டும்"

#: ingest/csvtools.py
#, python-format
msgid "file is larger than %(max)d bytes"
msgstr "கோப்பு %(max)d பைட்டுகளை விடப் பெரியது"

#: ingest/csvtools.py
msgid "file is empty"
msgstr "கோப்பு காலியாக உள்ளது"

#: ingest/csvtools.py
msgid "duplicate column"
msgstr "நிரல் இருமுறை உள்ளது"

#: ingest/csvtools.py
msgid "unknown column"
msgstr "தெரியாத நிரல்"

#: ingest/csvtools.py
msgid "required column is missing"
msgstr "தேவையான நிரல் இல்லை"

#: ingest/csvtools.py
#, python-format
msgid "longer than %(max)d characters"
msgstr "%(max)d எழுத்துகளை விட நீளமானது"

#: ingest/csvtools.py
#, python-format
msgid "must be one of: %(allowed)s"
msgstr "இவற்றில் ஒன்றாக இருக்க வேண்டும்: %(allowed)s"

#: ingest/csvtools.py
msgid "must be a date in YYYY-MM-DD format"
msgstr "YYYY-MM-DD வடிவில் தேதியாக இருக்க வேண்டும்"

#: ingest/csvtools.py
msgid "must be a decimal number"
msgstr "தசம எண்ணாக இருக்க வேண்டும்"

#: ingest/csvtools.py
#, python-format
msgid "must be between -%(limit)d and %(limit)d"
msgstr "-%(limit)d முதல் %(limit)d வரை இருக்க வேண்டும்"

#: ingest/csvtools.py
#, python-format
msgid "file is not valid UTF-8 (%(reason)s)"
msgstr "கோப்பு சரியான UTF-8 அல்ல (%(reason)s)"

#: ingest/csvtools.py
#, python-format
msgid "cannot read header: %(error)s"
msgstr "தலைப்பு வரியைப் படிக்க முடியவில்லை: %(error)s"

#: ingest/csvtools.py
#, python-format
msgid "malformed CSV: %(error)s"
msgstr "தவறான CSV வடிவம்: %(error)s"

#: ingest/csvtools.py
#, python-format
msgid "expected %(expected)d cells, got %(got)d"
msgstr "%(expected)d கலங்கள் எதிர்பார்க்கப்பட்டன, %(got)d கிடைத்தன"

#: ingest/csvtools.py
#, python-format
msgid "file has more than %(max)d data rows"
msgstr "கோப்பில் %(max)d-க்கு மேற்பட்ட தரவு வரிகள் உள்ளன"

#: ingest/csvtools.py
#, python-format
msgid "starts with '%(char)s', which spreadsheet programs may run as a formula; remove or reword the start of the value"
msgstr "'%(char)s' என்று தொடங்குகிறது; விரிதாள் நிரல்கள் இதைச் சூத்திரமாக இயக்கக்கூடும். மதிப்பின் தொடக்கத்தை நீக்கவும் அல்லது மாற்றி எழுதவும்"

#: ingest/load.py
msgid "this file has already been uploaded"
msgstr "இந்தக் கோப்பு ஏற்கெனவே பதிவேற்றப்பட்டுள்ளது"

#: ingest/load.py
#, python-format
msgid "already loaded into dataset '%(dataset)s'"
msgstr "ஏற்கெனவே '%(dataset)s' தரவுத் தொகுப்பில் ஏற்றப்பட்டுள்ளது"

#: ingest/load.py ingest/uploads.py
#, python-format
msgid "unknown district '%(name)s'"
msgstr "தெரியாத மாவட்டம் '%(name)s'"

#: ingest/parsers.py
msgid "is after valid_to"
msgstr "valid_to தேதிக்குப் பிறகு உள்ளது"

#: ingest/parsers.py
#, python-format
msgid "required for type '%(type)s'"
msgstr "'%(type)s' வகைக்குத் தேவை"

#: ingest/parsers.py
#, python-format
msgid "must be empty for type '%(type)s'"
msgstr "'%(type)s' வகைக்குக் காலியாக இருக்க வேண்டும்"

#: ingest/parsers.py
#, python-format
