msgstr "அதிகபட்சம் %(max)d எழுத்துகளைப் பயன்படுத்தவும்."

#: accounts/services.py
msgid "Use only English letters, digits and the characters @ . + - _"
msgstr "ஆங்கில எழுத்துகள், இலக்கங்கள் மற்றும் @ . + - _ குறிகளை மட்டும் பயன்படுத்தவும்"

#: accounts/services.py
msgid "You cannot disable your own account."
msgstr "உங்கள் சொந்தக் கணக்கை நீங்கள் முடக்க முடியாது."

#: accounts/services.py
msgid "The last active administrator cannot be disabled."
msgstr "செயலில் உள்ள கடைசி நிர்வாகியை முடக்க முடியாது."

